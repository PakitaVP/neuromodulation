library(dplyr)
library(ggplot2)
library(broom)
main <- function(){
library(dplyr)
library(ggplot2)
library(broom)
mask_file_paths <- list(
"con_extractions_probSN_task-NFTraining_summary.csv",
"con_extractions_probSNVTA_task-NFTraining_summary.csv",
"con_extractions_probVTA_task-NFTraining_summary.csv"
)
mask_config_list <- list(
list(file_path = "con_extractions_probSN_task-NFTraining_summary.csv", plot_title = "SN"),
list(file_path = "con_extractions_probSNVTA_task-NFTraining_summary.csv", plot_title = "SNVTA"),
list(file_path = "con_extractions_probVTA_task-NFTraining_summary.csv", plot_title = "VTA")
)
for (mask_config in mask_config_list)  {
mask_file = mask_config$file_path
title = mask_config$plot_title
run_mask_analysis(mask_file, title)
}
}
run_mask_analysis <- function(file_path, mask_title) {
# TR2-BL1
mask_file <- read.csv(file_path)
TR2_BL1_singlesubject <- mask_file %>%
group_by(subject) %>%
summarise(TR2_BL1_mean = last(mean) - first(mean), TR2_BL1_std = (first(std) + last(std)) / 2)
# Gruppenmittelwerte
feedback_gruppen <- mask_file %>%
select(subject, feedback_group) %>%
distinct()
TR2_BL1_singlesubject_withgroup <- TR2_BL1_singlesubject %>%
left_join(feedback_gruppen, by = "subject")
TR2_BL1_group <- TR2_BL1_singlesubject_withgroup %>%
group_by(feedback_group) %>%
summarise(mean = mean(TR2_BL1_mean), std = mean(TR2_BL1_std), .groups = "drop",)
# Signifikanz prüfen
pairwise.t.test(x = TR2_BL1_singlesubject_withgroup$TR2_BL1_mean,
g = TR2_BL1_singlesubject_withgroup$feedback_group,
p.adjust.method = "none")
# keine signifikanten gruppenunterschiede
#plot
groups <- factor(TR2_BL1_group$feedback_group,
levels = c(1, 2, 3),
labels = c("Reward", "Punishment", "Control"))
means <- TR2_BL1_group$mean
stds <- TR2_BL1_group$std
y_min <- min(means - stds)
y_max <- max(means + stds)
barplot1 <- ggplot(data = data.frame(group = groups, mean = means, std = stds),
aes(x = group, y = mean)) +
geom_bar(stat = "identity", fill = "lightblue", width = 0.7) +
geom_errorbar(aes(ymin = mean - std, ymax = mean + std),
width = 0.2, linewidth = 0.5) +
labs(
title = paste("Group difference in mean", mask_title, "activation (TR2-BL1)"),
x = "Group",
y = "Mean (TR2 - BL1)"
) +
ylim(y_min, y_max) +
theme_minimal()
save_plot(paste0(mask_title, "_TR2-BL1.pdf"), barplot1)
################################################################################
# TR2-BL2
TR2_BL2_singlesubject <- mask_file %>%
group_by(subject) %>%
summarise(TR2_BL2_mean = mean[9] - mean[6], TR2_BL2_std = ((std[9] + std[6]) / 2))
# Gruppenmittelwerte
feedback_gruppen <- mask_file %>%
select(subject, feedback_group) %>%
distinct()
TR2_BL2_singlesubject_withgroup <- TR2_BL2_singlesubject %>%
left_join(feedback_gruppen, by = "subject")
TR2_BL2_group <- TR2_BL2_singlesubject_withgroup %>%
group_by(feedback_group) %>%
summarise(mean = mean(TR2_BL2_mean), std = mean(TR2_BL2_std), .groups = "drop")
pairwise.t.test(x = TR2_BL2_singlesubject_withgroup$TR2_BL2_mean,
g = TR2_BL2_singlesubject_withgroup$feedback_group,
p.adjust.method = "none")
#plot
groups <- factor(TR2_BL2_group$feedback_group,
levels = c(1, 2, 3),
labels = c("Reward", "Punishment", "Control"))
means <- TR2_BL2_group$mean
stds <- TR2_BL2_group$std
y_min <- min(means - stds)
y_max <- max(means + stds)
barplot1 <- ggplot(data = data.frame(group = groups, mean = means, std = stds),
aes(x = group, y = mean)) +
geom_bar(stat = "identity", fill = "pink", width = 0.7) +
geom_errorbar(aes(ymin = mean - std, ymax = mean + std),
width = 0.2, linewidth = 0.5) +
labs(
title = paste("Group difference in mean", mask_title, "activation (TR2-BL2)"),
x = "Group",
y = "Mean (TR2 - BL2)"
) +
ylim(y_min, y_max) +
theme_minimal()
save_plot(paste0(mask_title, "_TR2-BL2.pdf"), barplot1)
################################################################################
# TR1-BL1
TR1_BL1_singlesubject <- mask_file %>%
group_by(subject) %>%
summarise(TR1_BL1_mean = mean[5] - mean[1], TR1_BL1_std = ((std[5] + std[1]) / 2))
# Gruppenmittelwerte
feedback_gruppen <- mask_file %>%
select(subject, feedback_group) %>%
distinct()
TR1_BL1_singlesubject_withgroup <- TR1_BL1_singlesubject %>%
left_join(feedback_gruppen, by = "subject")
TR1_BL1_group <- TR1_BL1_singlesubject_withgroup %>%
group_by(feedback_group) %>%
summarise(mean = mean(TR1_BL1_mean), std = mean(TR1_BL1_std), .groups = "drop")
pairwise.t.test(x = TR1_BL1_singlesubject_withgroup$TR1_BL1_mean,
g = TR1_BL1_singlesubject_withgroup$feedback_group,
p.adjust.method = "none")
#plot
groups <- factor(TR1_BL1_group$feedback_group,
levels = c(1, 2, 3),
labels = c("Reward", "Punishment", "Control"))
means <- TR1_BL1_group$mean
stds <- TR1_BL1_group$std
y_min <- min(means - stds)
y_max <- max(means + stds)
barplot1 = ggplot(data = data.frame(group = groups, mean = means, std = stds),
aes(x = group, y = mean)) +
geom_bar(stat = "identity", fill = "lightgreen", width = 0.7) +
geom_errorbar(aes(ymin = mean - std, ymax = mean + std),
width = 0.2, linewidth = 0.5) +
labs(
title = paste("Group difference in mean", mask_title, "activation (TR1-BL1)"),
x = "Group",
y = "Mean (TR1 - BL1)"
) +
ylim(y_min, y_max) +
theme_minimal()
save_plot(paste0(mask_title, "_TR1-BL1.pdf"), barplot1)
###############################################################################
# all TRAININGSRUNS
alltrainingsruns_singlesubject <- mask_file %>%
group_by(subject) %>%
slice(c(2, 3, 4, 7, 8)) %>%
mutate(run_name = c("2", "3", "4", "7", "8")) %>%
ungroup()
alltrainingsruns_group <- alltrainingsruns_singlesubject %>%
group_by(feedback_group, run_name) %>%
summarise(mean_value = mean(mean), std = mean(std), .groups = "drop")
# Plot
alltrainingsruns_group$feedback_group <- factor(alltrainingsruns_group$feedback_group,
levels = c(1, 2, 3),
labels = c("Reward", "Punishment", "Control")
)
plot <- ggplot(alltrainingsruns_group, aes(x = run_name, y = mean_value, group = feedback_group, color = feedback_group)) +
geom_line(linewidth = 1.2) +
geom_point(size = 3) +
geom_errorbar(aes(ymin = mean_value - std, ymax = mean_value + std),
width = 0.2, linewidth = 0.5, color = "black") +
labs(title = paste("Mean", mask_title, "activation over all trainingsruns"),
x = "Run",
y = "Mean Value",
color = "Group") +
theme_minimal()
save_plot(paste0(mask_title, "_trainingsruns_all.pdf"), plot)
# Auf Signifikanz prüfen
run_list <- unique(alltrainingsruns_singlesubject$run_name)
# T-Test pro Run
for (run_label in run_list) {
cat("\n---", run_label, "---\n")
df_sub <- alltrainingsruns_singlesubject %>% filter(run_name == run_label)
result <- pairwise.t.test(x = df_sub$mean,
g = df_sub$feedback_group,
p.adjust.method = "bonferroni")
print(result)
}
# Day 1 Trainingsruns
ses1_trainingsruns_singlesubject <- mask_file %>%
group_by(subject) %>%
slice(c(2, 3, 4)) %>%
mutate(run_name = c("2", "3", "4")) %>%
ungroup()
ses1_trainingsruns_group <- ses1_trainingsruns_singlesubject %>%
group_by(feedback_group, run_name) %>%
summarise(mean_value = mean(mean), std = mean(std), .groups = "drop")
# Plot
ses1_trainingsruns_group$feedback_group <- factor(ses1_trainingsruns_group$feedback_group,
levels = c(1, 2, 3),
labels = c("Reward", "Punishment", "Control")
)
plot <- ggplot(ses1_trainingsruns_group, aes(x = run_name, y = mean_value, group = feedback_group, color = as.factor(feedback_group))) +
geom_line(linewidth = 1.2) +
geom_point(size = 3) +
geom_errorbar(aes(ymin = mean_value - std, ymax = mean_value + std),
width = 0.2, linewidth = 0.5, color = "black") +
labs(title = paste("Mean", mask_title, "activation over over trainingsruns on day 1"),
x = "Run",
y = "Mean Value",
color = "Group") +
theme_minimal()
save_plot(paste0(mask_title, "_trainingsruns_ses1.pdf"), plot)
# Auf Signifikanz prüfen
run_list_ses1 <- unique(ses1_trainingsruns_singlesubject$run_name)
# T-Test pro Run
for (run_label in run_list_ses1) {
cat("\n---", run_label, "---\n")
df_sub_ses1 <- ses1_trainingsruns_singlesubject %>% filter(run_name == run_label)
result <- pairwise.t.test(x = df_sub_ses1$mean,
g = df_sub_ses1$feedback_group,
p.adjust.method = "bonferroni")
print(result)
}
# Day 2 Trainingsruns
ses2_trainingsruns_singlesubject <- mask_file %>%
group_by(subject) %>%
slice(c(7, 8)) %>%
mutate(run_name = c("7", "8")) %>%
ungroup()
ses2_trainingsruns_group <- ses2_trainingsruns_singlesubject %>%
group_by(feedback_group, run_name,) %>%
summarise(mean_value = mean(mean), std = mean(std), .groups = "drop")
# Plot
ses2_trainingsruns_group$feedback_group <- factor(ses2_trainingsruns_group$feedback_group,
levels = c(1, 2, 3),
labels = c("Reward", "Punishment", "Control")
)
plot <- ggplot(ses2_trainingsruns_group, aes(x = run_name, y = mean_value, group = feedback_group, color = as.factor(feedback_group))) +
geom_line(linewidth = 1.2) +
geom_point(size = 3) +
geom_errorbar(aes(ymin = mean_value - std, ymax = mean_value + std),
width = 0.2, linewidth = 0.5, color = "black") +
labs(title = paste("Mean", mask_title, "activation over over trainingsruns on day 2"),
x = "Run",
y = "Mean Value",
color = "Group") +
theme_minimal()
save_plot(paste0(mask_title, "_trainingsruns_ses2.pdf"), plot)
# Auf Signifikanz prüfen
run_list_ses2 <- unique(ses2_trainingsruns_singlesubject$run_name)
# T-Test pro Run
for (run_label in run_list_ses2) {
cat("\n---", run_label, "---\n")
df_sub_ses2 <- ses2_trainingsruns_singlesubject %>% filter(run_name == run_label)
result <- pairwise.t.test(x = df_sub_ses2$mean,
g = df_sub_ses2$feedback_group,
p.adjust.method = "bonferroni")
print(result)
}
}
save_plot <- function(filename, plot){
print(plot)
save_prefix_path = "../mask_plots/"
save_path = paste0(save_prefix_path, filename)
pdf(save_path, width = 7, height = 5)
print(plot)
dev.off()
}
